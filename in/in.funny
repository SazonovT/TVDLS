// Формулы начинаются с имени, без ключевого слова "formula"
Pos(x: int) => x > 0;

NonEmpty(a: int[], n: int) => n > 0;

AllPositive(a: int[], n: int) =>
    forall i: int => (i >= 0 and i < n) -> a[i] > 0;

// Простая функция с контрактами
function abs(x: int)
    requires true
    returns (r: int)
    ensures r >= 0 and (r == x or r == -x)
{
    if (x < 0) {
        r = -x;
    } else {
        r = x;
    }
}

// Функция с циклом и инвариантом
function sum(a: int[], n: int)
    requires n >= 0
    returns (s: int)
    ensures s >= 0
    uses Pos, AllPositive
{
    int i;
    s = 0;
    i = 0;

    while (i < n)
        invariant s >= 0 and i >= 0 and i <= n
    {
        s = s + a[i];
        i = i + 1;
    }

    assert s >= 0;
}

// Функция с множественным возвратом
function minMax(a: int[], n: int)
    requires n > 0
    returns (min: int, max: int)
    ensures min <= max
{
    int i;
    min = a[0];
    max = a[0];
    i = 1;

    while (i < n)
        invariant i >= 1 and i <= n
    {
        if (a[i] < min) {
            min = a[i];
        }
        if (a[i] > max) {
            max = a[i];
        }
        i = i + 1;
    }
}

// Функция с обменом значений
function swap(a: int[], i: int, j: int)
    requires i >= 0 and j >= 0 and i < 10 and j < 10
{
    int temp;
    temp = a[i];
    a[i] = a[j];
    a[j] = temp;
}

// Функция с вложенными условиями
function classify(x: int)
    returns (category: int)
{
    if (x < 0) {
        category = -1;
    } else if (x == 0) {
        category = 0;
    } else {
        category = 1;
    }
}

// Функция с assume и сложными предикатами
function search(a: int[], n: int, target: int)
    requires n >= 0
    returns (found: int)
    ensures found == -1 or (found >= 0 and found < n and a[found] == target)
{
    int i;
    i = 0;
    found = -1;

    while (i < n and found == -1)
        invariant i >= 0 and i <= n
    {
        if (a[i] == target) {
            found = i;
        }
        i = i + 1;
    }

    assume found == -1 or a[found] == target;
}

// Функция с логическими операциями
function complexCondition(x: int, y: int)
    returns (result: int)
{
    if ((x > 0 and y > 0) or (x < 0 and y < 0)) {
        result = 1;
    } else if (x == 0 or y == 0) {
        result = 0;
    } else {
        result = -1;
    }
}

// Главная функция
function main()
{
    int n;
    int s;

    n = 5;

    s = n * 3;
    assert s == 15;
}